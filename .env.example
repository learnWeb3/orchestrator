# OpenAI API key used by OpenAIProvider and the live integration test/example.
OPENAI_API_KEY=sk-...

# Model to exercise in examples/tests. gpt-5.4-mini is a reasoning model:
# OpenAIProvider auto-detects this and uses max_completion_tokens (no custom
# temperature) instead of max_tokens/temperature.
OPENAI_MODEL=gpt-5.4-mini

# Used by tests/test_conversation_history.py and examples against docker-compose.
MONGO_URL=mongodb://localhost:27017

# Used by tests/test_rate_limiter.py against docker-compose.
REDIS_URL=redis://localhost:6379/0
